# Supabase → Project Settings → API. The anon/publishable key is safe in the browser;
# access is enforced by Row Level Security. Never put a service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Production URL, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ISO 4217 currency code used to format prices.
NEXT_PUBLIC_CURRENCY=USD
